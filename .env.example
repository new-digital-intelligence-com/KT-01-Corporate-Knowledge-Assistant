# Copy to .env.local and fill in. See SETUP.md for where each value comes from.

# ─── Claude ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ─── Slack ───────────────────────────────────────────────────────────────
# Bot User OAuth Token (xoxb-…) of the read-only Slack app.
SLACK_BOT_TOKEN=
# Optional: only these channels (names or IDs, comma-separated).
# Default: every channel the bot has been invited to.
SLACK_CHANNELS=

# ─── Google Workspace (one service account with domain-wide delegation) ──
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json

# Drive: the assistant sees exactly what this user can see.
GOOGLE_DRIVE_USER=
# Optional: only these folder or shared drive IDs (subfolders included).
GOOGLE_DRIVE_FOLDER_IDS=

# Gmail: mailboxes to read, comma-separated. Use shared team mailboxes, not personal inboxes.
GMAIL_MAILBOXES=
# Optional Gmail search filter (the date filter is added automatically).
# GMAIL_QUERY=-in:spam -in:trash -in:chats -category:promotions -category:social

# Google Chat: the user whose named spaces are read (direct messages are never read).
GOOGLE_CHAT_USER=
# Optional: only these spaces (display names or spaces/XXXX IDs, comma-separated).
GOOGLE_CHAT_SPACES=
# Optional: an admin account, used only to turn Chat user IDs into names.
GOOGLE_ADMIN_EMAIL=

# ─── Sync ────────────────────────────────────────────────────────────────
# How far back the first sync reads.
SYNC_DAYS=180
SYNC_MAX_ITEMS_PER_SOURCE=5000

# ─── Google Chat bot (npm run chat-bot) ─────────────────────────────────
# Pull subscription that receives Google Chat events.
CHAT_PUBSUB_SUBSCRIPTION=projects/<project-id>/subscriptions/chat-events-sub
# Key of the bot's service account. Replies are posted with the chat.bot scope.
CHAT_BOT_KEY_FILE=./secrets/google-service-account.json
# Only people with an email in these domains get answers (comma-separated).
CHAT_ALLOWED_DOMAINS=yourcompany.com

# ─── Google sign-in (npm run google-login) ──────────────────────────────
# Connectors read Drive, Gmail and Chat as the signed-in person, read-only.
GOOGLE_OAUTH_CLIENT_FILE=./secrets/google-oauth-client.json
GOOGLE_USER_TOKEN_FILE=./secrets/google-user-token.json
# Shared drive that live Drive search is limited to (empty = every file the signed-in person can open).
GOOGLE_DRIVE_ID=

# ─── Deploying on Vercel ────────────────────────────────────────────────
# Vercel stores secrets as values, not files: paste each file's JSON into these instead of the *_FILE settings.
# CHAT_BOT_KEY_JSON=
# GOOGLE_OAUTH_CLIENT_JSON=
# GOOGLE_USER_TOKEN_JSON=
# The Chat endpoint's public URL, exactly as entered in Chat API → Configuration → HTTP endpoint URL.
CHAT_ENDPOINT_URL=https://<your-project>.vercel.app/api/google-chat
# "Service account email" shown in Chat API → Configuration for the add-on.
CHAT_ADDON_SERVICE_ACCOUNT=service-<project-number>@gcp-sa-gsuiteaddons.iam.gserviceaccount.com
# The web chat has no login, so on Vercel it is off unless this is true.
WEB_CHAT_ENABLED=false
# Lets the Vercel CLI deploy from this machine (vercel.com/account/settings/tokens). Never commit it.
VERCEL_TOKEN=
